# Copy to .env.local for local development, and add the same names in Vercel
# (Project Settings > Environment Variables). Never commit real values.

# Stripe secret key. Use a test key (sk_test_...) until you are ready to go live.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (whsec_...), from Stripe > Developers > Webhooks.
# Endpoint URL: https://YOUR-DOMAIN/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Public site address used for Stripe's return links, e.g. https://yehsha.com
# Optional: falls back to the address the request came in on.
NEXT_PUBLIC_SITE_URL=
